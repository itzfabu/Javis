claude-plugins/
*.mp3
.env
# Broad on purpose: only scratch/temp output is ever named .txt in this repo
# (e.g. voice-response staging). No real notes or docs use .txt - those are .md.
*.txt

# Exceptions to the blanket *.txt rule above: paths where overnight-run work
# products can legitimately land and must survive the backup, not silently
# vanish while the queue item that produced them says "done" (#2026-08-04
# overnight-runner safety testing - a gate-test proof file went uncommitted).
!orb/overnight-*.txt
!vault/**/*.txt

# Junctions/hardlinks into vault/ for Obsidian's 3D-graph vault scope (#see graphify session 2026-07-27).
# Git can't see these as links - it walks through them - so ignore the vault-side paths
# and keep tracking only the real C:\Jarvis locations.
vault/orb/
vault/.claude/
vault/knowledge/
vault/CLAUDE.md
vault/TASKS.md
vault/Jarvis-README.md

# Separately-cloned third-party tools with their own .git history - these are
# independent repos, not part of Jarvis. Ignored to avoid accidental embedded-repo
# gitlinks (#see 2026-07-28 tool-installation session).
/OpenSpace/
/camofox-browser/
/OpenMontage/
/reference/

# OmniRoute runtime data: SQLite DB (will hold encrypted provider keys once
# configured), WAL/SHM files, logs, PID - all generated, changes constantly
# while the server runs, and broke auto-backup's rebase step (#2026-07-28).
omniroute/data/

# graphify pipeline intermediates - deleted by the skill's own cleanup step at
# the end of every run, but an auto-backup firing mid-pipeline can catch them
# first. graph.json/GRAPH_REPORT.md/graph.html/manifest.json/cost.json/cache/
# are the real persistent outputs and stay tracked (#2026-07-28).
graphify-out/.graphify_detect.json
graphify-out/.graphify_extract.json
graphify-out/.graphify_ast.json
graphify-out/.graphify_semantic.json
graphify-out/.graphify_analysis.json
graphify-out/.graphify_chunk_*.json
graphify-out/.graphify_incremental.json
graphify-out/.graphify_old.json
graphify-out/.needs_update
